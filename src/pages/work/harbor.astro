---
import WorkProjectLayout from '@/layouts/WorkProjectLayout.astro'

const description = 'A native macOS app for reviewing pull requests, following CI, and working with local worktrees.'
---

<WorkProjectLayout
  title="Harbor"
  {description}
  eyebrow="Open source · macOS app"
  sourceHref="https://github.com/kaanbiryol/harbor"
  visualCaption="Harbor showing a pull request diff with an unresolved inline thread."
  details={{ type: 'Native macOS app', focus: 'Pull request review', stack: 'Rust · GPUI' }}
>
  <img
    slot="visual"
    src="/work/harbor.webp"
    alt="Harbor showing a pull request diff with an inline review thread"
    width="2400"
    height="1553"
    loading="eager"
    decoding="async"
  />

  <h2>Why I’m building Harbor</h2>
  <p>
    Reviewing a pull request often means jumping between GitHub, CI logs, and a terminal. Harbor keeps repositories,
    changed files, inline threads, checks, workflow runs, logs, and local worktrees in one native app.
  </p>
  <p>
    I’m building it in Rust with GPUI. It talks to GitHub through REST and GraphQL, and keeps a local SQLite cache. The
    project is still early and currently focused on macOS.
  </p>
</WorkProjectLayout>

<style>
  img {
    display: block;
    height: auto;
    width: 100%;
  }
</style>
