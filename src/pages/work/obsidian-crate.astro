---
import WorkProjectLayout from '@/layouts/WorkProjectLayout.astro'

const description = 'An Obsidian plugin that keeps vault sync and reminders inside your own Cloudflare account.'
---

<WorkProjectLayout
  title="Crate"
  {description}
  eyebrow="Open source · Obsidian"
  sourceHref="https://github.com/kaanbiryol/obsidian-crate"
  details={{ type: 'Obsidian plugin', focus: 'Self-hosted sync', stack: 'TypeScript · Cloudflare' }}
>
  <h2>Sync that runs in your own account</h2>
  <p>
    Crate tracks file changes, renames, attachments, conflicts, and devices. The plugin talks to a Worker deployed in
    your Cloudflare account, which also handles reminders.
  </p>
  <p>
    R2 stores the files, D1 stores sync metadata, and Durable Objects schedule reminder alarms. The project is still
    early. There is no hosted Crate service or separate account.
  </p>
</WorkProjectLayout>
