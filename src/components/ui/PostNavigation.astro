---
import type { AdjacentPost } from '@/types'
import { renderInlineMarkdown } from '@/utils/inline-markdown'

interface Props {
  newerPost?: AdjacentPost | undefined
  olderPost?: AdjacentPost | undefined
}

const { newerPost, olderPost } = Astro.props
---

{
  (newerPost || olderPost) && (
    <nav class="post-navigation" aria-label="More articles">
      {newerPost && (
        <a class="post-navigation__link post-navigation__link--newer" href={`/${newerPost.id}/`}>
          <span class="post-navigation__direction">Previous article</span>
          <span class="post-navigation__title" set:html={renderInlineMarkdown(newerPost.title)} />
          <span class="post-navigation__arrow" aria-hidden="true">
            &#8592;
          </span>
        </a>
      )}
      {olderPost && (
        <a class="post-navigation__link post-navigation__link--older" href={`/${olderPost.id}/`}>
          <span class="post-navigation__direction">Next article</span>
          <span class="post-navigation__title" set:html={renderInlineMarkdown(olderPost.title)} />
          <span class="post-navigation__arrow" aria-hidden="true">
            &#8594;
          </span>
        </a>
      )}
    </nav>
  )
}

<style>
  .post-navigation {
    border-top: 1px solid var(--border);
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 3rem;
    padding-top: 1.25rem;
  }

  :global(.related-writing) + .post-navigation {
    margin-top: 2.5rem;
  }

  .post-navigation__link {
    display: grid;
    gap: 0.2rem 0.625rem;
    grid-template-columns: minmax(0, 1fr) auto;
    min-width: 0;
    padding: 0.25rem 0;
    text-decoration: none;
  }

  .post-navigation__link--older {
    grid-column: 2;
  }

  .post-navigation__link:only-child {
    grid-column: 1 / -1;
    max-width: 100%;
  }

  .post-navigation__direction {
    color: var(--text-secondary);
    font-size: var(--font-size-s);
    grid-column: 1;
    line-height: 1.4;
  }

  .post-navigation__title {
    color: var(--text-primary);
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
    grid-column: 1;
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.16em;
    transition: text-decoration-color 0.15s ease-out;
  }

  .post-navigation__title :global(code) {
    font-size: 0.9em;
  }

  .post-navigation__arrow {
    align-self: center;
    color: var(--text-secondary);
    grid-column: 2;
    grid-row: 1 / span 2;
    transition:
      color 0.15s ease-out,
      transform 0.15s ease-out;
  }

  .post-navigation__link:hover,
  .post-navigation__link:focus-visible {
    text-decoration: none;
  }

  .post-navigation__link:hover .post-navigation__title,
  .post-navigation__link:focus-visible .post-navigation__title {
    text-decoration-color: var(--text-tertiary);
  }

  .post-navigation__link:hover .post-navigation__arrow,
  .post-navigation__link:focus-visible .post-navigation__arrow {
    color: var(--text-primary);
  }

  .post-navigation__link--newer:hover .post-navigation__arrow,
  .post-navigation__link--newer:focus-visible .post-navigation__arrow {
    transform: translateX(-0.2rem);
  }

  .post-navigation__link--older:hover .post-navigation__arrow,
  .post-navigation__link--older:focus-visible .post-navigation__arrow {
    transform: translateX(0.2rem);
  }

  @media (max-width: 620px) {
    .post-navigation {
      gap: 1.25rem;
      grid-template-columns: 1fr;
    }

    .post-navigation__link--older {
      grid-column: 1;
    }
  }
</style>
