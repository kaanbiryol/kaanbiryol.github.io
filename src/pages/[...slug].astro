---
import type { CollectionEntry } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import { render } from 'astro:content'
import type { AdjacentPost } from '@/types'
import { getSortedFilteredPosts } from '@/utils/draft'
import { getRelatedPosts } from '@/utils/related-posts'

export async function getStaticPaths() {
  const posts = await getSortedFilteredPosts()
  return posts.map((post, index) => {
    const toAdjacentPost = (entry: CollectionEntry<'posts'> | undefined): AdjacentPost | undefined =>
      entry ? { id: entry.id, title: entry.data.title } : undefined

    return {
      params: { slug: post.id },
      props: {
        post,
        relatedPosts: getRelatedPosts(post, posts),
        newerPost: toAdjacentPost(posts[index - 1]),
        olderPost: toAdjacentPost(posts[index + 1])
      }
    }
  })
}

interface Props {
  post: CollectionEntry<'posts'>
  relatedPosts: ReturnType<typeof getRelatedPosts>
  newerPost?: AdjacentPost
  olderPost?: AdjacentPost
}

const { post, relatedPosts, newerPost, olderPost } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)

const readingTime = remarkPluginFrontmatter.readingTime
const toc = remarkPluginFrontmatter.toc || []
---

<PostLayout
  {...post.data}
  readingTime={readingTime}
  toc={toc}
  relatedPosts={relatedPosts}
  newerPost={newerPost}
  olderPost={olderPost}
>
  <Content />
</PostLayout>
