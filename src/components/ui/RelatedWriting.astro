---
import type { RelatedPost } from '@/types'
import TopicList from '@/components/ui/TopicList.astro'
import { renderInlineMarkdown } from '@/utils/inline-markdown'

interface Props {
  posts?: RelatedPost[]
}

const { posts = [] } = Astro.props
---

{
  posts.length > 0 && (
    <section class="related-writing" aria-label="Related writing">
      <header class="related-writing__header">
        <h2>Related writing</h2>
      </header>
      <ul class="related-writing__list">
        {posts.map((post) => (
          <li>
            <article>
              <h3>
                <a class="related-writing__link" href={`/${post.id}/`} set:html={renderInlineMarkdown(post.title)} />
              </h3>
              <p class="related-writing__description" set:html={renderInlineMarkdown(post.description)} />
              <div class="related-writing__footer">
                <TopicList topics={post.sharedTopics} label="Shared topics" />
                <span class="related-writing__arrow" aria-hidden="true">
                  &#8594;
                </span>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related-writing {
    margin-top: 2rem;
  }

  .related-writing__header {
    margin-bottom: 1rem;
  }

  .related-writing__header h2 {
    font-size: var(--font-size-m);
    line-height: 1.4;
    margin: 0;
  }

  .related-writing__list {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related-writing__list > li {
    margin: 0;
    min-width: 0;
    padding: 0;
  }

  .related-writing__list > li::before {
    content: none;
    display: none;
  }

  .related-writing__link {
    color: var(--text-primary);
    display: block;
    text-decoration: none;
  }

  .related-writing__link:hover,
  .related-writing__link:focus-visible {
    text-decoration: none;
  }

  .related-writing article {
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem;
    position: relative;
    transition:
      background-color 0.15s ease-out,
      border-color 0.15s ease-out;
  }

  .related-writing article:has(.related-writing__link:hover),
  .related-writing article:focus-within {
    background: var(--code-bg);
    border-color: var(--text-tertiary);
  }

  .related-writing__link::after {
    content: '';
    inset: 0;
    position: absolute;
  }

  .related-writing h3 {
    font-size: var(--font-size-m);
    line-height: 1.45;
    margin: 0;
  }

  .related-writing__description {
    color: var(--text-secondary);
    display: -webkit-box;
    font-size: var(--font-size-s);
    line-height: 1.55;
    margin: 0.5rem 0 1rem;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .related-writing__footer {
    align-items: end;
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    margin-top: auto;
  }

  .related-writing__footer :global(.topic-list) {
    margin-top: 0;
  }

  .related-writing__arrow {
    color: var(--text-secondary);
    flex: none;
    font-size: var(--font-size-s);
    line-height: 1.45;
  }

  @media (max-width: 620px) {
    .related-writing__list {
      grid-template-columns: 1fr;
    }

    .related-writing__description {
      -webkit-line-clamp: 2;
    }
  }
</style>
